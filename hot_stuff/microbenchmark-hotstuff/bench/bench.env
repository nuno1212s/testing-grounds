# ── Project identity ─────────────────────────────────────────────────────────────
# These variables are required and must be set in every project bench.env.
# The Dockerfile and build context are always bench/Dockerfile and the Atlas repo
# root respectively — those do not need to be specified here.

# PROJECT_NAME: human-readable label used in logs and help output.
PROJECT_NAME=microbenchmark-hotstuff

# IMAGE_NAME: the local Docker image tag built by `make local`.
IMAGE_NAME=microbenchmark-hotstuff

# BINARY_NAME: the Cargo binary name as declared in the project's Cargo.toml
#   [[bin]] name = "...". Must match exactly — this is what cargo puts in
#   target/release/ and what remote-bare deploys.
BINARY_NAME=microbenchmark-hotstuff

# RUST_SRC_RELPATH: path from THIS bench/ directory to the directory that contains
#   the Cargo.toml to build (workspace root or single-package root). Used only by
#   the `build-binary` target for native compilation (remote-bare mode).
#   Note: `..` goes up from bench/ to the package root (microbenchmark-hotstuff/).
RUST_SRC_RELPATH=..

# APP_SOURCE_DIR is computed automatically from RUST_SRC_RELPATH — do not set it here.

#── Docker image (remote-docker mode) ────────────────────────────────────────────
# DOCKER_IMAGE / DOCKER_VERSION: the pre-built registry image pulled for remote-docker
#   deployments. Not used for local builds (IMAGE_NAME is used there instead).
DOCKER_IMAGE=nukino/atlas-microbenchmark-hotstuff
DOCKER_VERSION=latest

# ── Workload overrides ────────────────────────────────────────────────────────────
# Uncomment and adjust to override global defaults from testing-grounds/bench/bench.env.
# N_REPLICAS=4
# CONCURRENT_RQS=200

# ── App-specific container vars ───────────────────────────────────────────────────
# Any vars added below are passed to containers via env_file alongside the global
# bench.env. Use this for runtime feature flags, tuning knobs, etc.
