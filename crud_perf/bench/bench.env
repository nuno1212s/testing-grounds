# ── Project identity ─────────────────────────────────────────────────────────────
PROJECT_NAME=crud_perf
IMAGE_NAME=crud-perf
BINARY_NAME=crud_perf_exec
RUST_SRC_RELPATH=../crud_perf_exec
DOCKER_IMAGE=nukino/atlas-crud-perf
DOCKER_VERSION=latest

# ── Workload knobs (override per experiment sweep) ────────────────────────────────
# uniform_cheap | uniform_expensive | mixed_8020 | adversarial | crud_proportional
WORKLOAD_TYPE=uniform_cheap
# Collision rate control: smaller = more key collisions between clients
# ~0% collision: KEY_SPACE_SIZE >> N_CLIENTS * CONCURRENT_RQS * 100
# ~100% collision: KEY_SPACE_SIZE=1
KEY_SPACE_SIZE=1000000
# Sleep duration (ms) injected for expensive ops
EXPENSIVE_OP_SLEEP_MS=10
# Set to true to send all requests as Ordered (reads included), for baseline comparison
FORCE_ORDERED=false
# Key distribution: uniform | zipf
KEY_DISTRIBUTION=uniform
# Zipf constant: 0.1 = near-uniform, >0.5 = hot-key skew
ZIPF_CONSTANT=0.1
# CRUD operation mix weights (used for crud_proportional and as default mix for all types)
READ_RATIO=70
CREATE_RATIO=15
UPDATE_RATIO=10
DELETE_RATIO=5

# ── Executor variant under test ───────────────────────────────────────────────────
# Selects which executor is compiled into the binary. Exactly one, and it also becomes
# the InfluxDB `extra` tag, so runs are self-identifying at analysis time.
#   baseline      - atlas-smr-execution, post-commit (the comparison baseline)
#   dual_state    - preemptive, two full state copies, confirmed worker re-executes
#   crud_single   - preemptive, single-threaded cache/delta, no re-execution
#   crud_scalable - preemptive, parallel cache/delta with collision detection
# Leave empty to use the crate default (crud_single).
#
# Honoured by every mode that builds: `local` (as the CARGO_FEATURES Docker build arg,
# which also becomes part of the image tag), `build-binary` and `remote-bare` (as cargo
# --no-default-features --features). NOT honoured by `remote-docker`, which only pulls
# DOCKER_IMAGE:DOCKER_VERSION — bake the variant into that image and select it with
# DOCKER_VERSION instead; the target warns when it sees a variant it cannot apply.
EXECUTOR_VARIANT=crud_single

# ── Experiment-suite knobs ────────────────────────────────────────────────────────
# Read at run time; the defaults keep a plain `make crud_perf local` unchanged.

# How a request's cost is spent on the replica.
#   sleep - thread::sleep (latency, no CPU)
#   spin  - busy-wait (holds a core)
PROCESSING_MODE=sleep
# Per-operation cost in microseconds; overrides EXPENSIVE_OP_SLEEP_MS when non-zero.
EXPENSIVE_OP_SLEEP_US=0
# Keys 0..PRELOAD_KEYS-1 present in every replica before the first request (0 = empty).
PRELOAD_KEYS=0
# Time-based phases. MEASURE_SECS > 0 replaces the op-count phases (OPS_NUMBER is ignored).
WARMUP_SECS=0
MEASURE_SECS=0
# 1 = each request also writes two points to InfluxDB (heavy at benchmark throughput).
CLIENT_REQUEST_METRICS=1

# ── Run-time knob passthrough ─────────────────────────────────────────────────────
# Copied into every container's environment so command-line overrides reach the binary
# (see bench/scripts/gen-local-compose.sh). CONCURRENT_RQS, OPS_NUMBER and REQUEST_SLEEP_MILLIS
# are listed too: the environment outranks the TOML, so the env_file's copy would beat an override.
RUNTIME_ENV_PASSTHROUGH=CONCURRENT_RQS OPS_NUMBER REQUEST_SLEEP_MILLIS WORKLOAD_TYPE KEY_SPACE_SIZE EXPENSIVE_OP_SLEEP_MS EXPENSIVE_OP_SLEEP_US FORCE_ORDERED KEY_DISTRIBUTION ZIPF_CONSTANT READ_RATIO CREATE_RATIO UPDATE_RATIO DELETE_RATIO TARGET_COLLISION_RATE EXPECTED_BATCH_SIZE PROCESSING_MODE PRELOAD_KEYS WARMUP_SECS MEASURE_SECS CLIENT_REQUEST_METRICS RQ_TRACKING CLIENT_FAULT_SENDS_TO CLIENT_FAULT_CLIENT CLIENT_FAULT_SENDS
