# ── Cluster sizing ────────────────────────────────────────────────────────────────
# N_REPLICAS: number of replica processes (one per machine for remote deployments)
N_REPLICAS=4
# N_CLIENT_MACHINES: number of machines used to run client processes
N_CLIENT_MACHINES=1
# N_CLIENTS: logical clients per client machine (total = N_CLIENTS × N_CLIENT_MACHINES).
# Each machine runs exactly one client process that spawns N_CLIENTS logical clients internally.
N_CLIENTS=5

# ── Client workload ───────────────────────────────────────────────────────────────
# CONCURRENT_RQS: max in-flight requests per logical client
CONCURRENT_RQS=200
OPS_NUMBER=1000000
REQUEST_SLEEP_MILLIS=0

# ── Payload sizes (bytes, 0 = empty) ─────────────────────────────────────────────
REQUEST_SIZE=0
REPLY_SIZE=0
STATE_SIZE=0

# ── PKI / ca-root ─────────────────────────────────────────────────────────────────
# CA_ROOT_FORMAT: layout of the generated ca-root directory.
#   flattened  (default) — FlattenedPathConstructor: ca-root/ca-root-{id}-private, etc.
#                          Use this when the app imports atlas_default_configs with
#                          FlattenedPathConstructor (the common case).
#   folder               — FolderPathConstructor:    ca-root/{id}/private, etc.
#                          Use this when the app uses FolderPathConstructor, e.g. when
#                          keying material was generated by the Atlas keygen tool.
CA_ROOT_FORMAT=flattened

# ── Local InfluxDB ────────────────────────────────────────────────────────────────
# Set to 1 to spin up a local InfluxDB 1.8 container alongside replicas/clients.
# Set to 0 if you have an external InfluxDB (edit config-base/common/influx_db.toml).
LOCAL_INFLUXDB=0

# ── WAN emulation (local mode only) ───────────────────────────────────────────────
# Injects per-link latency, jitter, loss and bandwidth caps between containers using
# tc/netem, so WAN topologies can be studied locally. Off by default: with
# WAN_ENABLED=0 nothing below has any effect and the local flow is unchanged.
#
# Run `make <project> wan-check` once before first use — netem needs the sch_netem
# kernel module, which some container VMs (notably podman machine) omit.
# Author profiles with `make <project> wan-plan`; see bench/wan-profiles/.
WAN_ENABLED=0
# WAN_PROFILE: basename of a file in bench/wan-profiles/ (without .yml).
WAN_PROFILE=wan-global-3region
# WAN_SUBNET: WAN mode assigns static container IPs so tc filters stay valid across
# container restarts. Only used when WAN_ENABLED=1.
WAN_SUBNET=10.90.0.0/24
# WAN_IFACE: interface shaped inside each container.
WAN_IFACE=eth0
# WAN_SHAPE_CLIENTS: 1 shapes client<->replica links too, 0 shapes replica<->replica only.
WAN_SHAPE_CLIENTS=1
# WAN_TIMEOUT_SCALE: multiplies timeout_duration in the GENERATED configs. The values in
# config-base assume a LAN; raise this (e.g. 4) for high-delay or lossy profiles that
# would otherwise trigger spurious view changes. 1 = leave configs untouched.
WAN_TIMEOUT_SCALE=1

# ── Logging ───────────────────────────────────────────────────────────────────────
RUST_LOG=INFO

# ── Remote deployment ─────────────────────────────────────────────────────────────
ANSIBLE_USER=nneto
REMOTE_WORKDIR=/home/nneto/atlas-bench
