# ── Cluster sizing ────────────────────────────────────────────────────────────────
# N_REPLICAS: number of replica processes (one per machine for remote deployments)
N_REPLICAS=4
# N_CLIENT_MACHINES: number of machines used to run client processes
N_CLIENT_MACHINES=1
# N_CLIENTS: logical clients per client machine (total = N_CLIENTS × N_CLIENT_MACHINES).
# Each machine runs exactly one client process that spawns N_CLIENTS logical clients internally.
N_CLIENTS=5

# ── Client workload ───────────────────────────────────────────────────────────────
# CONCURRENT_RQS: max in-flight requests per logical client
CONCURRENT_RQS=200
OPS_NUMBER=1000000
REQUEST_SLEEP_MILLIS=0

# ── Payload sizes (bytes, 0 = empty) ─────────────────────────────────────────────
REQUEST_SIZE=0
REPLY_SIZE=0
STATE_SIZE=0

# ── PKI / ca-root ─────────────────────────────────────────────────────────────────
# CA_ROOT_FORMAT: layout of the generated ca-root directory.
#   flattened  (default) — FlattenedPathConstructor: ca-root/ca-root-{id}-private, etc.
#                          Use this when the app imports atlas_default_configs with
#                          FlattenedPathConstructor (the common case).
#   folder               — FolderPathConstructor:    ca-root/{id}/private, etc.
#                          Use this when the app uses FolderPathConstructor, e.g. when
#                          keying material was generated by the Atlas keygen tool.
CA_ROOT_FORMAT=flattened

# ── Metrics stack (InfluxDB + Grafana) ────────────────────────────────────────────
# InfluxDB and Grafana are one Compose project — bench/grafana/docker-compose.yml —
# started by `make metrics` (alias: `make grafana`) and, unless METRICS_AUTOSTART=0,
# automatically by every target that starts a run. It is deliberately NOT part of the
# generated benchmark stack: the database has to outlive the run that filled it.
#
# LOCAL_INFLUXDB
#   1 (default) — the stack runs its own InfluxDB, and the generated replica/client
#                 configs are rewritten to reach it as http://influxdb:8086 over
#                 atlas_network. This is the batteries-included path.
#   0           — no InfluxDB container; everything (replicas, clients, Grafana)
#                 talks to the external instance named in
#                 config-base/common/influx_db.toml.
LOCAL_INFLUXDB=1

# METRICS_AUTOSTART: 1 (default) makes `local`, `remote-docker` and `remote-bare`
# bring the metrics stack up first and block until InfluxDB answers. Set to 0 to run
# a benchmark without touching it (note that a node whose InfluxDB is unreachable
# aborts — see bench/README.md, "Why the wait matters").
METRICS_AUTOSTART=1

# ── InfluxDB container ────────────────────────────────────────────────────────────
# Only used when LOCAL_INFLUXDB=1. The db name, user and password are NOT set here:
# they are read from config-base/common/influx_db.toml, the same file the replicas
# read, so the server and its writers can never disagree.
#
# The INFLUXDB_ prefix matters. Atlas' config crate reads `INFLUX_`-prefixed env vars
# straight into the influx client config (INFLUX_IP, INFLUX_DB_NAME, INFLUX_USER,
# INFLUX_PASSWORD, INFLUX_EXTRA), and this file is also the containers' env_file — so
# a var named INFLUX_PORT here would silently become a field of that config.
INFLUXDB_IMAGE=influxdb:1.8
INFLUXDB_PORT=8086
# INFLUXDB_BIND: host interface the port is published on. Loopback by default because
# HTTP auth is off; set 0.0.0.0 for remote-docker / remote-bare runs, whose nodes have
# to reach this host (and then set INFLUXDB_AUTH_ENABLED=true).
INFLUXDB_BIND=127.0.0.1
# INFLUXDB_AUTH_ENABLED: false lets anything on atlas_network write. The admin user
# from influx_db.toml is created either way, so flipping this to true works without
# recreating the volume — but it only takes effect on restart of the container.
INFLUXDB_AUTH_ENABLED=false
# INFLUXDB_RETENTION: duration for the database's default retention policy, applied on
# every `make metrics` (e.g. 30d, 12w). Empty leaves the policy alone — and a fresh
# database keeps everything forever. A busy suite writes tens of thousands of points a
# second, so a laptop wants a bound here.
INFLUXDB_RETENTION=

# ── Grafana ───────────────────────────────────────────────────────────────────────
# Provisioned with a datasource pointing at whichever InfluxDB LOCAL_INFLUXDB selects
# above — the stack's own container, or the instance in influx_db.toml.
#
#   make metrics        # from testing-grounds/ — no project name needed
#   make stop-metrics
GRAFANA_IMAGE=grafana/grafana:11.4.0
GRAFANA_PORT=3000
# GRAFANA_BIND: host interface the port is published on. Loopback by default because
# anonymous access is enabled; set 0.0.0.0 to reach it from another machine (and then
# consider turning GRAFANA_ANONYMOUS off).
GRAFANA_BIND=127.0.0.1
GRAFANA_ANONYMOUS=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# Optional overrides — leave empty to derive everything from influx_db.toml.
# Useful to point Grafana at a different InfluxDB than the one the run writes to.
GRAFANA_INFLUX_URL=
GRAFANA_INFLUX_DB=
GRAFANA_INFLUX_USER=
GRAFANA_INFLUX_PASSWORD=

# ── Metrics run tag ───────────────────────────────────────────────────────────────
# Every metric point carries an `extra` tag, which is "None" unless set. Give a run a
# name here (or on the command line) and Grafana's "Run" variable can separate it from
# every other run in the same database:
#
#   make crud_perf local INFLUX_EXTRA=baseline-4r
#
# Deliberately left commented out rather than set empty: this file is also the
# containers' env_file, and INFLUX_EXTRA="" would tag every point with an empty string
# instead of leaving the tag at its "None" default.
#INFLUX_EXTRA=baseline

# ── WAN emulation (local mode only) ───────────────────────────────────────────────
# Injects per-link latency, jitter, loss and bandwidth caps between containers using
# tc/netem, so WAN topologies can be studied locally. Off by default: with
# WAN_ENABLED=0 nothing below has any effect and the local flow is unchanged.
#
# Run `make <project> wan-check` once before first use — netem needs the sch_netem
# kernel module, which some container VMs (notably podman machine) omit.
# Author profiles with `make <project> wan-plan`; see bench/wan-profiles/.
WAN_ENABLED=0
# WAN_PROFILE: basename of a file in bench/wan-profiles/ (without .yml).
WAN_PROFILE=wan-global-3region
# WAN_SUBNET: WAN mode assigns static container IPs so tc filters stay valid across
# container restarts. Only used when WAN_ENABLED=1.
WAN_SUBNET=10.90.0.0/24
# WAN_IFACE: interface shaped inside each container.
WAN_IFACE=eth0
# WAN_SHAPE_CLIENTS: 1 shapes client<->replica links too, 0 shapes replica<->replica only.
WAN_SHAPE_CLIENTS=1
# WAN_TIMEOUT_SCALE: multiplies timeout_duration in the GENERATED configs. The values in
# config-base assume a LAN; raise this (e.g. 4) for high-delay or lossy profiles that
# would otherwise trigger spurious view changes. 1 = leave configs untouched.
WAN_TIMEOUT_SCALE=1

# ── Logging ───────────────────────────────────────────────────────────────────────
RUST_LOG=INFO

# ── Remote deployment ─────────────────────────────────────────────────────────────
ANSIBLE_USER=nneto
REMOTE_WORKDIR=/home/nneto/atlas-bench
