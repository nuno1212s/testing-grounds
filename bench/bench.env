# ── Cluster sizing ────────────────────────────────────────────────────────────────
# N_REPLICAS: number of replica processes (one per machine for remote deployments)
N_REPLICAS=4
# N_CLIENT_MACHINES: number of machines used to run client processes
N_CLIENT_MACHINES=1
# N_CLIENTS: total client processes, distributed round-robin across N_CLIENT_MACHINES
N_CLIENTS=1

# ── Client workload ───────────────────────────────────────────────────────────────
# CLIENTS_TO_RUN: logical clients within each client process
CLIENTS_TO_RUN=5
# CONCURRENT_RQS: max in-flight requests per logical client
CONCURRENT_RQS=200
OPS_NUMBER=1000000
REQUEST_SLEEP_MILLIS=0

# ── Payload sizes (bytes, 0 = empty) ─────────────────────────────────────────────
REQUEST_SIZE=0
REPLY_SIZE=0
STATE_SIZE=0

# ── PKI / ca-root ─────────────────────────────────────────────────────────────────
# CA_ROOT_FORMAT: layout of the generated ca-root directory.
#   flattened  (default) — FlattenedPathConstructor: ca-root/ca-root-{id}-private, etc.
#                          Use this when the app imports atlas_default_configs with
#                          FlattenedPathConstructor (the common case).
#   folder               — FolderPathConstructor:    ca-root/{id}/private, etc.
#                          Use this when the app uses FolderPathConstructor, e.g. when
#                          keying material was generated by the Atlas keygen tool.
CA_ROOT_FORMAT=flattened

# ── Local InfluxDB ────────────────────────────────────────────────────────────────
# Set to 1 to spin up a local InfluxDB 1.8 container alongside replicas/clients.
# Set to 0 if you have an external InfluxDB (edit config-base/common/influx_db.toml).
LOCAL_INFLUXDB=0

# ── Logging ───────────────────────────────────────────────────────────────────────
RUST_LOG=INFO

# ── Remote deployment ─────────────────────────────────────────────────────────────
ANSIBLE_USER=nneto
REMOTE_WORKDIR=/home/nneto/atlas-bench
