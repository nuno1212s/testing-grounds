{
  "uid": "atlas-overview",
  "title": "Atlas \u2014 Cluster Overview",
  "description": "Cross-suite entry point. Start here, then open the dashboard for the suite you are actually running.",
  "tags": [
    "atlas",
    "bench",
    "overview"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "1s",
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "atlas-influx"
        },
        "query": "SHOW TAG VALUES WITH KEY = \"host\"",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "hide": 0,
        "description": "Atlas tags every point with host=NodeId(n): replicas are 0..n-1, clients start at 1000. Keep multi/includeAll on \u2014 the values contain parentheses, and Grafana only regex-escapes multi-value variables."
      },
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "atlas-influx"
        },
        "query": "SHOW TAG VALUES WITH KEY = \"extra\"",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1,
        "hide": 0,
        "description": "The `extra` tag: 'None' unless the run set INFLUX_EXTRA. Suites share one database and several measurement names, so filter by Run before comparing anything across protocols."
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Ordered throughput",
      "description": "Mean across replicas. Empty for suites with no executor metrics (microbenchmarks legacy) \u2014 use the per-suite dashboard there.",
      "datasource": {
        "type": "influxdb",
        "uid": "atlas-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "atlas-influx"
          },
          "query": "SELECT mean(\"value\") FROM \"OPERATIONS_EXECUTED_PER_SECOND\" WHERE (\"host\" =~ /^$host$/ AND \"extra\" =~ /^$run$/) AND $timeFilter GROUP BY time($__interval) fill(none)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "mean"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Client request rate",
      "description": "",
      "datasource": {
        "type": "influxdb",
        "uid": "atlas-influx"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "atlas-influx"
          },
          "query": "SELECT sum(\"rate\") FROM (SELECT mean(\"value\") AS \"rate\" FROM \"CLIENT_RQ_PER_SECOND\" WHERE (\"host\" =~ /^$host$/ AND \"extra\" =~ /^$run$/) AND $timeFilter GROUP BY time($__interval), \"host\") GROUP BY time($__interval) fill(none)",
          "rawQuery": true,
          "resultFormat": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 0,
